COMPOSE_PROJECT_NAME=dy-dashboard

# Public entrypoint. Keep raw service ports unpublished; expose only proxy.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

POSTGRES_DB=dy_dashboard
POSTGRES_USER=dy_dashboard
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://dy_dashboard:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/dy_dashboard

API_IMAGE=dy-dashboard-api:local
WORKER_IMAGE=dy-dashboard-worker:local
OPS_AGENT_IMAGE=dy-dashboard-ops-agent:local
WEB_IMAGE=dy-dashboard-web:local
BROWSER_IMAGE=dy-dashboard-browser:local
API_UPSTREAM=http://api:8000

DY_SUPER_ADMIN_USERNAME=CHANGE_ME_SUPER_ADMIN_USERNAME
DY_SUPER_ADMIN_PASSWORD_HASH=CHANGE_ME_SUPER_ADMIN_PASSWORD_HASH
DY_SESSION_SECRET=CHANGE_ME_SESSION_SECRET
DY_SESSION_COOKIE_SECURE=true
DY_WEB_BASE_URL=https://dy-business-engine.com
DY_AGENT_ENVIRONMENT=production
UVICORN_HOST=0.0.0.0

DOUYIN_APP_ID=CHANGE_ME_DOUYIN_APP_ID
DOUYIN_APP_SECRET=CHANGE_ME_DOUYIN_APP_SECRET
DOUYIN_ACCOUNT_ID=CHANGE_ME_DOUYIN_ACCOUNT_ID
DOUYIN_PRODUCT_SYNC_ENABLED=true
DOUYIN_PRODUCT_SYNC_INTERVAL_SECONDS=86400
DOUYIN_PRODUCT_GOODS_QUERY_TYPE=2
DOUYIN_PRODUCT_PAGE_SIZE=50

BROWSER_VNC_PASSWORD=CHANGE_ME_BROWSER_VNC_PASSWORD
CHROMIUM_START_URL=https://life.douyin.com/
BROWSER_CDP_URL=http://browser:9222
BROWSER_EXPORT_DOWNLOAD_DIR=/home/browser/Downloads/job-runs
BROWSER_EXPORT_ARTIFACT_DIR=/data/browser-exports
BROWSER_SCREEN_WIDTH=1440
BROWSER_SCREEN_HEIGHT=1000

WORKER_COMMAND=python -m apps.worker.scheduler
WORKER_EXECUTE_DAILY_CHILD=false
# Ops Agent uses a dedicated least-privilege database role. Never reuse the API role.
OPS_AGENT_DATABASE_URL=postgresql+psycopg://dy_ops_agent:CHANGE_ME_OPS_AGENT_PASSWORD@postgres:5432/dy_dashboard

# Benchmark-tuning defaults only; production values require the 4C/8GB acceptance run.
WORKER_MATERIALIZATION_STAGE_TIMEOUT_SECONDS=7200
WORKER_CLUE_MASTER_BATCH_SIZE=2000
API_MEMORY_LIMIT=768m
WORKER_MEMORY_LIMIT=3g
BROWSER_MEMORY_LIMIT=2g
OPS_AGENT_MEMORY_LIMIT=256m
WORKER_RESOURCE_GUARD_ENABLED=true
WORKER_RESOURCE_WARN_HOST_USED_BYTES=6442450944
WORKER_RESOURCE_STOP_HOST_USED_BYTES=6871947673
WORKER_RESOURCE_MAX_PROCESS_TREE_RSS_BYTES=2147483648
WORKER_RESOURCE_MAX_CGROUP_CURRENT_BYTES=3221225472
WORKER_RESOURCE_MAX_SWAP_USED_BYTES=0
WORKER_STOP_GRACE_PERIOD=5m
OPS_AGENT_COMMAND_TTL_SECONDS=120
OPS_AGENT_COOLDOWN_SECONDS=300
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
